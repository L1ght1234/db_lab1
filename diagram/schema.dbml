Project sports_management {
  database_type: 'PostgreSQL'
  Note: 'Турніри, команди, матчі, події, квитки, спонсори та аудит'
}

Enum audit_operation {
  INSERT
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
}

Enum match_event_type {
  goal
  own_goal
  penalty
  point
  foul
  yellow_card
  red_card
  substitution
  injury
  timeout
  other
}

Enum match_status {
  scheduled
  in_progress
  completed
  cancelled
  postponed
}

Enum ticket_status {
  reserved
  paid
  cancelled
  refunded
}

Enum tournament_status {
  draft
  registration
  ongoing
  completed
  cancelled
}

TableGroup "Користувачі та ролі" {
  roles
  users
}

TableGroup "Довідники та арени" {
  sports
  venues
  ticket_categories
  sponsors
}

TableGroup "Команди" {
  teams
  team_members
}

TableGroup "Турніри" {
  tournaments
  tournament_stages
  tournament_teams
  tournament_sponsors
}

TableGroup "Матчі" {
  matches
  match_results
  match_events
  match_officials
}

TableGroup "Квитки" {
  tickets
}

TableGroup "Аудит" {
  audit_log
}

Table roles {
  id integer [pk, increment]
  name varchar(50) [not null, unique]
  description text
}

Table users {
  id integer [pk, increment]
  role_id integer [not null, ref: > roles.id]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(30)
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.id']
  updated_at timestamptz
  updated_by integer [note: 'FK -> users.id']
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.id']
  Note: 'SOFT DELETE + AUDIT (created_by, updated_at/updated_by, deleted_at/deleted_by)'
}

Table sports {
  id integer [pk, increment]
  name varchar(100) [not null, unique]
  type varchar(50) [not null]
  rules_url text
}

Table venues {
  id integer [pk, increment]
  name varchar(150) [not null]
  city varchar(100) [not null]
  address varchar(255) [not null]
  capacity integer [not null]
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.id']
  updated_at timestamptz
  updated_by integer [note: 'FK -> users.id']
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.id']
  Note: 'SOFT DELETE + AUDIT'
}

Table ticket_categories {
  id integer [pk, increment]
  venue_id integer [not null, ref: > venues.id]
  name varchar(50) [not null]
  base_price numeric(10,2) [not null]
}

Table sponsors {
  id integer [pk, increment]
  name varchar(150) [not null, unique]
  contact_person varchar(100)
  contact_email varchar(255)
  created_at timestamptz [not null, default: `now()`]
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.id']
  Note: 'SOFT DELETE'
}

Table teams {
  id integer [pk, increment]
  sport_id integer [not null, ref: > sports.id]
  name varchar(120) [not null]
  city varchar(100)
  founded_year integer
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.id']
  updated_at timestamptz
  updated_by integer [note: 'FK -> users.id']
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.id']

  indexes {
    `sport_id, lower((name)::text)` [unique, type: btree, name: 'uq_teams_active_name', note: 'BTREE WHERE (NOT is_deleted)']
  }
  Note: 'SOFT DELETE + AUDIT'
}

Table team_members {
  id integer [pk, increment]
  team_id integer [not null, ref: > teams.id]
  user_id integer [not null, ref: > users.id]
  jersey_number integer
  position varchar(50)
  joined_at date [not null, default: `CURRENT_DATE`]
  contract_until date
}

Table tournaments {
  id integer [pk, increment]
  sport_id integer [not null, ref: > sports.id]
  name varchar(150) [not null]
  season varchar(20) [not null]
  start_date date [not null]
  end_date date [not null]
  status tournament_status [not null, default: `'draft'`]
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.id']
  updated_at timestamptz
  updated_by integer [note: 'FK -> users.id']
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.id']
  Note: 'SOFT DELETE + AUDIT'
}

Table tournament_stages {
  id integer [pk, increment]
  tournament_id integer [not null, ref: > tournaments.id]
  name varchar(100) [not null]
  stage_order integer [not null]
}

Table tournament_teams {
  id integer [pk, increment]
  tournament_id integer [not null, ref: > tournaments.id]
  team_id integer [not null, ref: > teams.id]
  registered_at timestamptz [not null, default: `now()`]
  seed_number integer
}

Table tournament_sponsors {
  id integer [pk, increment]
  tournament_id integer [not null, ref: > tournaments.id]
  sponsor_id integer [not null, ref: > sponsors.id]
  contract_amount numeric(12,2) [not null]
  signed_at date [not null, default: `CURRENT_DATE`]
}

Table matches {
  id integer [pk, increment]
  stage_id integer [not null, ref: > tournament_stages.id]
  venue_id integer [not null, ref: > venues.id]
  home_team_id integer [not null, ref: > teams.id]
  away_team_id integer [not null, ref: > teams.id]
  scheduled_at timestamptz [not null]
  status match_status [not null, default: `'scheduled'`]
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.id']
  updated_at timestamptz
  updated_by integer [note: 'FK -> users.id']
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.id']

  indexes {
    (stage_id, scheduled_at) [type: btree, name: 'ix_matches_stage_scheduled', note: 'BTREE WHERE (NOT is_deleted)']
  }
  Note: 'SOFT DELETE + AUDIT'
}

Table match_results {
  id integer [pk, increment]
  match_id integer [not null, unique, ref: - matches.id]
  home_score integer [not null, default: `0`]
  away_score integer [not null, default: `0`]
  winner_team_id integer [ref: > teams.id]
  is_extra_time boolean [not null, default: `false`]
  is_penalties boolean [not null, default: `false`]
  notes text
  Note: '1:1 з matches (UNIQUE match_id); NULL у winner_team_id = нічия'
}

Table match_events {
  id integer [pk, increment]
  match_id integer [not null, ref: > matches.id]
  player_id integer [ref: > users.id]
  event_type match_event_type [not null]
  minute integer [not null]
  details_jsonb jsonb

  indexes {
    details_jsonb [name: 'gx_match_events_details', note: 'GIN']
  }
  Note: 'GIN індекс на details_jsonb; Hash індекс на event_type'
}

Table match_officials {
  id integer [pk, increment]
  match_id integer [not null, ref: > matches.id]
  user_id integer [not null, ref: > users.id]
  duty_role varchar(50) [not null]
}

Table tickets {
  id integer [pk, increment]
  match_id integer [not null, ref: > matches.id]
  category_id integer [not null, ref: > ticket_categories.id]
  buyer_user_id integer [not null, ref: > users.id]
  seat_number varchar(30) [not null]
  price_paid numeric(10,2) [not null]
  status ticket_status [not null, default: `'reserved'`]
  purchased_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by integer [note: 'FK -> users.id']
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.id']

  indexes {
    (match_id, seat_number) [unique, type: btree, name: 'uq_tickets_active_seat', note: 'BTREE WHERE ((NOT is_deleted) AND (status = ANY (ARRAY[reserved::ticket_status, paid::ticket_status])))']
  }
  Note: 'SOFT DELETE + AUDIT; частковий UNIQUE на (match_id, seat_number)'
}

Table audit_log {
  id bigint [pk, increment]
  table_name varchar(63) [not null]
  record_id integer [not null]
  operation audit_operation [not null]
  old_data jsonb
  new_data jsonb
  changed_by integer [note: 'FK -> users.id']
  changed_at timestamptz [not null, default: `now()`]

  indexes {
    new_data [name: 'gx_audit_log_new_data', note: 'GIN']
    (table_name, record_id) [type: btree, name: 'ix_audit_log_table_record', note: 'BTREE']
  }
  Note: 'Журнал змін зі старими і новими значеннями в JSONB (GIN + BRIN індекси)'
}
